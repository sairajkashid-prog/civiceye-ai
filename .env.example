# ── CivicEye AI environment configuration ──────────────────────────────
# 1. Copy this file to `.env`  →  cp .env.example .env
# 2. Replace every value with a strong secret of your own.
# 3. Never commit the real `.env` — it is already listed in .gitignore.
#
# docker compose automatically reads these variables (see docker-compose.yml).

# Password for the PostgreSQL `civiceye` user
POSTGRES_PASSWORD=replace-with-a-strong-database-password

# Secret used to sign and verify JWT access tokens (use a long random string,
# e.g. `openssl rand -hex 32`)
JWT_SECRET=replace-with-a-long-random-string
